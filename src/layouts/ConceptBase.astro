---
import '../../tokens.css';

interface Props {
  title: string;
  description: string;
  concept: 'chooser' | 'reading-room' | 'studio-notes' | 'personal-index';
  googleFonts?: string;
  fontshareFonts?: string;
}

const { title, description, concept, googleFonts, fontshareFonts } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-concept={concept}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {googleFonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {googleFonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {googleFonts && <link rel="stylesheet" href={googleFonts} />}
    {fontshareFonts && <link rel="stylesheet" href={fontshareFonts} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!link.dataset.email) return;
      event.preventDefault();
      const email = atob(link.dataset.email);
      link.href = `mailto:${email}`;
      link.removeAttribute('data-email');
      window.location.href = link.href;
    }, { once: true });
  });
</script>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-width: 0;
    overflow-x: clip;
  }

  html {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 100%;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100dvh;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.6;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  a:active {
    color: var(--color-accent);
    text-decoration-thickness: var(--rule-heavy);
  }

  a[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol,
  dl,
  dd,
  figure,
  blockquote {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
  }

  h1,
  h2,
  h3 {
    font-style: normal;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  ::selection {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 150ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 150ms !important;
    }
  }
</style>
